#!/usr/bin/env python3
import math
import struct
import wave
from pathlib import Path

RATE = 22050
OUT = Path(__file__).resolve().parent


def noise(i):
    return ((i * 1103515245 + 12345) & 0x7FFFFFFF) / 0x7FFFFFFF * 2.0 - 1.0


def clamp(x):
    return max(-1.0, min(1.0, x))


def quantize(x, bits):
    steps = float((1 << (bits - 1)) - 1)
    return round(clamp(x) * steps) / steps


def write_wav(name, samples):
    path = OUT / name
    with wave.open(str(path), "w") as fh:
        fh.setnchannels(1)
        fh.setsampwidth(2)
        fh.setframerate(RATE)
        fh.writeframes(b"".join(struct.pack("<h", int(clamp(s) * 28000)) for s in samples))


def thock():
    samples = []
    for i in range(int(RATE * 0.092)):
        t = i / RATE
        e = math.exp(-t * 34)
        body = math.sin(2 * math.pi * 156 * t) * 0.52 + math.sin(2 * math.pi * 84 * t) * 0.38
        tick = math.sin(2 * math.pi * 640 * t) * math.exp(-t * 78) * 0.16
        air = noise(i) * math.exp(-t * 62) * 0.10
        samples.append(quantize(body * e + tick + air, 7))
    return samples


def click():
    samples = []
    for i in range(int(RATE * 0.048)):
        t = i / RATE
        high = math.sin(2 * math.pi * 1840 * t) * math.exp(-t * 86) * 0.28
        mid = math.sin(2 * math.pi * 410 * t) * math.exp(-t * 48) * 0.34
        kiss = noise(i + 17) * math.exp(-t * 110) * 0.08
        samples.append(quantize(high + mid + kiss, 8))
    return samples


def chip():
    samples = []
    n = int(RATE * 0.078)
    for i in range(n):
        t = i / RATE
        freq = 390.0 - 140.0 * (t / 0.078)
        phase = 2 * math.pi * freq * t
        square = 0.28 * math.sin(phase) + 0.09 * math.sin(3 * phase)
        e = math.exp(-t * 28) * (1.0 - math.exp(-t * 220))
        samples.append(quantize(square * e, 6))
    return samples


def hush():
    samples = []
    prev = 0.0
    for i in range(int(RATE * 0.11)):
        t = i / RATE
        white = noise(i + 91)
        prev = prev * 0.82 + white * 0.18
        tap = (white - prev) * 0.55 + prev * 0.22
        e = math.exp(-t * 26) * min(1.0, t * 90)
        samples.append(quantize(tap * e * 0.7, 8))
    return samples


def square(freq, t):
    return 1.0 if math.sin(2 * math.pi * freq * t) >= 0 else -1.0


def tri(freq, t):
    return 2 * abs(2 * ((t * freq) % 1.0) - 1) - 1


def note_env(t, length, attack=0.012, release=0.08):
    if t < 0 or t > length:
        return 0.0
    a = min(1.0, t / attack)
    r = 1.0 if t < length - release else max(0.0, (length - t) / release)
    return a * r


def music():
    rate = 22050
    bpm = 92
    beat = 60.0 / bpm
    melody = [
        (659.25, 1.0),
        (783.99, 1.0),
        (880.00, 1.5),
        (783.99, 0.5),
        (659.25, 1.0),
        (587.33, 1.0),
        (523.25, 2.0),
        (587.33, 1.0),
        (659.25, 1.0),
        (783.99, 1.5),
        (880.00, 0.5),
        (987.77, 1.0),
        (880.00, 1.0),
        (783.99, 2.0),
        (659.25, 1.0),
        (523.25, 3.0),
    ]
    bass = [
        (130.81, 2.0),
        (196.00, 2.0),
        (174.61, 2.0),
        (196.00, 2.0),
        (130.81, 2.0),
        (164.81, 2.0),
        (174.61, 2.0),
        (196.00, 2.0),
    ]
    total = sum(length for _freq, length in melody) * beat
    n = int(rate * total)
    samples = []
    for i in range(n):
        t = i / rate
        lead = 0.0
        cursor = 0.0
        for freq, length in melody:
            dur = length * beat
            lead += square(freq, t) * note_env(t - cursor, dur) * 0.045
            cursor += dur
        pulse = 0.0
        cursor = 0.0
        for freq, length in bass:
            dur = length * beat
            pulse += tri(freq, t) * note_env(t - cursor, dur, 0.02, 0.12) * 0.07
            cursor += dur
        pad = tri(196.00, t) * 0.018 + tri(261.63, t) * 0.012
        samples.append(quantize(lead + pulse + pad, 7))
    return samples


def clear():
    samples = []
    n = int(RATE * 0.17)
    for i in range(n):
        t = i / RATE
        a = math.sin(2 * math.pi * 523 * t) * math.exp(-t * 12) * 0.34
        b = 0.0
        if t > 0.045:
            u = t - 0.045
            b = math.sin(2 * math.pi * 784 * t) * math.exp(-u * 11) * 0.30
        click = math.sin(2 * math.pi * 1180 * t) * math.exp(-t * 70) * 0.08
        samples.append(quantize((a + b + click) * (1.0 - math.exp(-t * 180)), 7))
    return samples


if __name__ == "__main__":
    write_wav("thock.wav", thock())
    write_wav("click.wav", click())
    write_wav("chip.wav", chip())
    write_wav("hush.wav", hush())
    write_wav("clear.wav", clear())
    write_wav("music.wav", music())
