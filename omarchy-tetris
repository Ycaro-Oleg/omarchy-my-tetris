        self.game = Game(mode)
        self.page = "play"

    def record_score(self) -> None:
        game = self.game
        if game is None:
            return
        row = {
            "score": game.score,
            "lines": game.lines,
            "level": game.level,
            "time_ms": game.clock_ms(),
            "finished": bool(game.won),
            "at": time.strftime("%Y-%m-%d %H:%M"),
        }
        self.scores.add(game.mode, row)

    def read_keys(self, timeout: float) -> list[str]:
        keys: list[str] = []
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if ready:
            try:
                chunk = os.read(sys.stdin.fileno(), 64)
            except OSError:
                chunk = b""
            self.buf.extend(chunk)
        data = bytes(self.buf)
        self.buf.clear()
        i = 0
        while i < len(data):
            b = data[i]
            if b == 0x1B:
                if i + 2 < len(data) and data[i + 1] == ord("["):
                    code = data[i + 2]
                    mapping = {ord("A"): "up", ord("B"): "down", ord("C"): "right", ord("D"): "left"}
                    keys.append(mapping.get(code, "esc"))
                    i += 3
                    continue
                if i + 1 == len(data):
                    keys.append("esc")
                    i += 1
                    continue
                keys.append("esc")
                i += 1
                continue
            if b in (3,):
                keys.append("quit")
            elif b in (13, 10):
                keys.append("enter")
            elif b == 32:
                keys.append("space")
            elif b in (127, 8):
                keys.append("back")
            else:
                ch = chr(b).lower()
                names = {
                    "a": "left",
                    "d": "right",
                    "s": "down",
                    "w": "up",
                    "x": "up",
                    "z": "ccw",
                    "c": "hold",
                    "p": "pause",
                    "q": "quit",
                    "r": "retry",
                    "h": "left",
                    "l": "right",
                    "j": "down",
                    "k": "up",
                }
                keys.append(names.get(ch, ch))
            i += 1
        return keys

    def handle_menu(self, keys: list[str]) -> None:
        for key in keys:
            if key in ("up", "k"):
                self.menu_index = (self.menu_index - 1) % len(MODES)
            elif key in ("down", "j"):
                self.menu_index = (self.menu_index + 1) % len(MODES)
            elif key in ("enter", "space"):
                self.start_mode(MODES[self.menu_index])
            elif key in ("1", "2", "3"):
                self.menu_index = int(key) - 1
                self.start_mode(MODES[self.menu_index])
            elif key in ("quit", "esc", "q"):
                self.running = False

    def handle_play(self, keys: list[str]) -> None:
        game = self.game
        if game is None:
            return
        if not game.alive:
            for key in keys:
                if key in ("enter", "retry", "r", "space"):
                    if not game.saved:
                        self.record_score()
                        game.saved = True
                    self.start_mode(game.mode)
                    return
                if key in ("quit", "esc", "q"):
                    if not game.saved:
                        self.record_score()
                        game.saved = True
                    self.page = "menu"
                    return
            return
        for key in keys:
            if key in ("pause", "p", "esc"):
                game.toggle_pause()
                continue
            if game.paused:
                if key in ("quit", "q"):
                    self.record_if_needed()
                    self.page = "menu"
                    return
                if key in ("retry", "r"):
                    self.record_if_needed()
                    self.start_mode(game.mode)
                    return
                continue
            if key == "left":
                game.try_move(-1, 0)
            elif key == "right":
                game.try_move(1, 0)
            elif key == "down":
                game.soft_drop()
            elif key == "up":
                game.try_rotate(1)
            elif key == "ccw":
                game.try_rotate(-1)
            elif key == "space":
                game.hard_drop()
            elif key == "hold":
                game.swap_hold()
            elif key in ("retry", "r"):
                self.record_if_needed()
                self.start_mode(game.mode)
                return
            elif key == "quit":
                self.record_if_needed()
                self.page = "menu"
                return

    def record_if_needed(self) -> None:
        game = self.game
        if game is None or game.saved:
            return
        if game.score > 0 or game.lines > 0:
            if game.alive and game.clock_ms() > 1500:
                game.finish(False)
            if not game.alive:
                self.record_score()
                game.saved = True

    def min_size(self) -> tuple[int, int]:
        return 56, 24

    def draw(self) -> None:
        self.screen.refresh_size()
        cols, rows = self.screen.cols, self.screen.rows
        need_w, need_h = self.min_size()
        bg = self.theme.bg
        lines: list[str] = []
        if cols < need_w or rows < need_h:
            msg = f"Need at least {need_w}x{need_h}  (now {cols}x{rows})"
            for y in range(rows):
                if y == rows // 2:
                    pad = max(0, (cols - len(msg)) // 2)
                    text = " " * pad + msg
                    text = text[:cols].ljust(cols)
                    lines.append(paint(text, self.theme.fg, bg) + RESET)
                else:
                    lines.append(self.screen.fill_line(cols, bg))
            self.blit(lines)
            return
        if self.page == "menu":
            lines = self.draw_menu(cols, rows, bg)
        else:
            lines = self.draw_play(cols, rows, bg)
        self.blit(lines)

    def blit(self, lines: list[str]) -> None:
        rows = self.screen.rows
        cols = self.screen.cols
        while len(lines) < rows:
            lines.append(self.screen.fill_line(cols, self.theme.bg))
        sys.stdout.write("\x1b[H" + "\n".join(lines[:rows]))
        sys.stdout.flush()

    def draw_menu(self, cols: int, rows: int, bg: tuple[int, int, int]) -> list[str]:
        theme = self.theme
        letters = [
            ("T", theme.piece("T")),
            ("E", theme.piece("I")),
            ("T", theme.piece("O")),
            ("R", theme.piece("Z")),
            ("I", theme.piece("J")),
            ("S", theme.piece("S")),
        ]
        title = "  ".join(paint(ch, color, bg) for ch, color in letters)
        title_plain = "  ".join(ch for ch, _ in letters)
        subtitle = "theme  " + theme.name
        hint = "enter play   ↑↓ select   q quit"
        body: list[tuple[str, tuple[int, int, int]]] = []
        body.append(("", theme.fg))
        body.append((title_plain, theme.fg))
        body.append((subtitle, theme.muted))
        body.append(("", theme.fg))
        for i, mode in enumerate(MODES):
            selected = i == self.menu_index
            mark = "▸ " if selected else "  "
            best = self.scores.best(mode)
            if mode == "sprint":
                best_txt = fmt_time(int(best["time_ms"])) if best and best.get("finished") else "—"
            else:
                best_txt = fmt_score(int(best["score"])) if best else "—"
            line1 = f"{mark}{MODE_LABEL[mode]}"
            line2 = f"    {MODE_BLURB[mode]}"
            line3 = f"    best  {best_txt}"
            color = theme.accent if selected else theme.fg
            muted = theme.accent if selected else theme.muted
            body.append((line1, color))
            body.append((line2, muted))
            body.append((line3, muted))
            body.append(("", theme.fg))
        body.append((hint, theme.muted))
        top = max(1, (rows - len(body)) // 2)
        lines: list[str] = []
        for y in range(rows):
            idx = y - top
            if 0 <= idx < len(body):
                text, color = body[idx]
                if idx == 1:
                    pad = max(0, (cols - len(title_plain)) // 2)
                    row = paint(" " * pad, theme.fg, bg) + title + paint(" " * max(0, cols - pad - len(title_plain)), theme.fg, bg) + RESET
                    lines.append(row)
                    continue
                pad = max(0, (cols - len(text)) // 2)
                filled = (" " * pad + text)[:cols].ljust(cols)
                if 0 <= idx < len(body) and body[idx][0].startswith("▸"):
                    lines.append(paint(filled, color, mix(theme.selection, bg, 0.55)) + RESET)
                else:
                    lines.append(paint(filled, color, bg) + RESET)
            else:
                lines.append(self.screen.fill_line(cols, bg))
        return lines

    def draw_play(self, cols: int, rows: int, bg: tuple[int, int, int]) -> list[str]:
        game = self.game
        assert game is not None
        theme = self.theme
        well_w = COLS * CELL + 2
        side = 14
        gap = 2
        total_w = side + gap + well_w + gap + side
        left0 = max(1, (cols - total_w) // 2)
        well0 = left0 + side + gap
        right0 = well0 + well_w + gap
        header_y = max(0, (rows - (ROWS + 3)) // 2)
        well_y = header_y + 2
        canvas = [[(" ", theme.fg, bg) for _ in range(cols)] for _ in range(rows)]

        def put(x: int, y: int, ch: str, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            if 0 <= y < rows and 0 <= x < cols:
                canvas[y][x] = (ch[:1], fg, bgc)

        def put_str(x: int, y: int, text: str, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            for i, ch in enumerate(text):
                put(x + i, y, ch, fg, bgc)

        def put_cell(x: int, y: int, color: tuple[int, int, int], ghost: bool = False) -> None:
            if ghost:
                ink = mix(color, theme.well, 0.42)
                put(x, y, "░", ink, theme.well)
                put(x + 1, y, "░", ink, theme.well)
            else:
                put(x, y, " ", theme.fg, color)
                put(x + 1, y, " ", theme.fg, color)

        title = f"TETRIS  ·  {MODE_LABEL[game.mode]}"
        put_str(well0, header_y, title, theme.accent, bg)
        name = theme.name
        put_str(max(well0, cols - len(name) - 2), header_y, name, theme.muted, bg)

        for y in range(ROWS):
            put(well0, well_y + y, "│", theme.muted, theme.well)
            put(well0 + well_w - 1, well_y + y, "│", theme.muted, theme.well)
            for x in range(COLS):
                shade = theme.well_alt if (x + y) % 2 else theme.well
                put_cell(well0 + 1 + x * CELL, well_y + y, shade)
        put_str(well0, well_y - 1, "╭" + "─" * (well_w - 2) + "╮", theme.muted, theme.well)
        put_str(well0, well_y + ROWS, "╰" + "─" * (well_w - 2) + "╯", theme.muted, theme.well)

        for y in range(ROWS):
            for x in range(COLS):
                kind = game.board.grid[y][x]
                if kind:
                    color = theme.piece(kind)
                    if y in game.clearing:
                        color = mix(theme.rgb("bright_foreground"), color, 0.75)
                    put_cell(well0 + 1 + x * CELL, well_y + y, color)

        if game.piece and game.alive and not game.paused:
            ghost = game.ghost()
            if ghost:
                for x, y in ghost.blocks():
                    if 0 <= y < ROWS:
                        put_cell(well0 + 1 + x * CELL, well_y + y, theme.piece(game.piece.kind), ghost=True)
            for x, y in game.piece.blocks():
                if 0 <= y < ROWS:
                    put_cell(well0 + 1 + x * CELL, well_y + y, theme.piece(game.piece.kind))

        def mini(kind: Optional[str], ox: int, oy: int) -> None:
            box_w = 12
            put_str(ox, oy, "╭" + "─" * (box_w - 2) + "╮", theme.muted, bg)
            for row in range(2):
                put(ox, oy + 1 + row, "│", theme.muted, bg)
                put_str(ox + 1, oy + 1 + row, " " * (box_w - 2), theme.fg, theme.well)
                put(ox + box_w - 1, oy + 1 + row, "│", theme.muted, bg)
            put_str(ox, oy + 3, "╰" + "─" * (box_w - 2) + "╯", theme.muted, bg)
            if not kind:
                return
            blocks = SHAPES[kind][0]
            minx = min(b[0] for b in blocks)
            miny = min(b[1] for b in blocks)
            maxx = max(b[0] for b in blocks)
            maxy = max(b[1] for b in blocks)
            pw = (maxx - minx + 1) * CELL
            ph = maxy - miny + 1
            sx = ox + 1 + max(0, (box_w - 2 - pw) // 2)
            sy = oy + 1 + max(0, (2 - ph) // 2)
            for cx, cy in blocks:
                put_cell(sx + (cx - minx) * CELL, sy + (cy - miny), theme.piece(kind))

        put_str(left0, well_y - 1, "HOLD", theme.muted, bg)
        mini(game.hold, left0, well_y)
        put_str(left0, well_y + 5, "SCORE", theme.muted, bg)
        put_str(left0, well_y + 6, fmt_score(game.score), theme.fg, bg)
        put_str(left0, well_y + 8, "LEVEL", theme.muted, bg)
        put_str(left0, well_y + 9, str(game.level), theme.fg, bg)
        put_str(left0, well_y + 11, "LINES", theme.muted, bg)
        if game.mode == "sprint":
            put_str(left0, well_y + 12, f"{min(game.lines, SPRINT_LINES)} / {SPRINT_LINES}", theme.fg, bg)
        else:
            put_str(left0, well_y + 12, str(game.lines), theme.fg, bg)
        if game.mode == "ultra":
            put_str(left0, well_y + 14, "TIME", theme.muted, bg)
            put_str(left0, well_y + 15, fmt_time(game.remaining_ms()), theme.accent, bg)
        elif game.mode == "sprint":
            put_str(left0, well_y + 14, "TIME", theme.muted, bg)
            put_str(left0, well_y + 15, fmt_time(game.clock_ms()), theme.accent, bg)
        if game.banner and time.monotonic() < game.banner_until:
            put_str(left0, well_y + 17, game.banner, theme.accent, bg)

        put_str(right0, well_y - 1, "NEXT", theme.muted, bg)
        for i, kind in enumerate(game.next):
            mini(kind, right0, well_y + i * 4)

        help_y = min(rows - 1, well_y + ROWS + 1)
        help_txt = "←→ move   ↑ rotate   z ccw   space drop   c hold   p pause   q menu"
        put_str(max(0, (cols - len(help_txt)) // 2), help_y, help_txt, theme.muted, bg)

        overlay = ""
        if game.paused:
            overlay = "PAUSED"
            sub = "p resume   r retry   q menu"
        elif not game.alive:
            if game.mode == "sprint" and game.won:
                overlay = "CLEARED"
                sub = f"{fmt_time(game.clock_ms())}    enter retry   q menu"
            elif game.mode == "ultra":
                overlay = "TIME UP" if game.won else "TOP OUT"
                sub = f"{fmt_score(game.score)}    enter retry   q menu"
            else:
                overlay = "GAME OVER"
                sub = f"{fmt_score(game.score)}    enter retry   q menu"
        if overlay:
            box_w = max(len(overlay), len(sub)) + 6
            box_h = 5
            ox = well0 + (well_w - box_w) // 2
            oy = well_y + (ROWS - box_h) // 2
            panel = mix(theme.rgb("darker_background"), theme.selection, 0.55)
            for yy in range(box_h):
                for xx in range(box_w):
                    put(ox + xx, oy + yy, " ", theme.fg, panel)
            put_str(ox + (box_w - len(overlay)) // 2, oy + 1, overlay, theme.accent, panel)
            put_str(ox + (box_w - len(sub)) // 2, oy + 3, sub, theme.fg, panel)

        lines: list[str] = []
        for y in range(rows):
            parts: list[str] = []
            last_fg = None
            last_bg = None
            run = []
            def flush() -> None:
                if not run:
                    return
                parts.append(paint("".join(run), last_fg, last_bg))
                run.clear()
            for ch, fg, bgc in canvas[y]:
                if fg != last_fg or bgc != last_bg:
                    flush()
                    last_fg, last_bg = fg, bgc
                run.append(ch)
            flush()
            parts.append(RESET)
            lines.append("".join(parts))
        return lines

    def setup_term(self) -> None:
        self.old_term = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b]0;Tetris\x07")
        sys.stdout.flush()

    def restore_term(self) -> None:
        sys.stdout.write("\x1b[?7h\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if self.old_term is not None:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.old_term)

    def run(self) -> int:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            sys.stderr.write("omarchy-tetris needs an interactive terminal\n")
            return 1
        try:
            sys.stdout.reconfigure(encoding="utf-8")
        except Exception:
            pass
        self.setup_term()

        def handle_int(_sig, _frame) -> None:
            self.running = False

        signal.signal(signal.SIGINT, handle_int)
        signal.signal(signal.SIGTERM, handle_int)
        try:
            while self.running:
                self.theme.reload()
                now = time.monotonic()
                if self.page == "play" and self.game is not None:
                    self.game.tick(now)
                    if not self.game.alive and not self.game.saved:
                        self.record_score()
                        self.game.saved = True
                self.draw()
                keys = self.read_keys(TICK)
                if self.page == "menu":
                    self.handle_menu(keys)
                else:
                    self.handle_play(keys)
        finally:
            self.restore_term()
        return 0


def main() -> int:
    return App().run()


if __name__ == "__main__":
    raise SystemExit(main())
