        self.board = Board()
        self.bag = Bag()
        self.next = [self.bag.take() for _ in range(3)]
        self.hold: Optional[str] = None
        self.hold_used = False
        self.score = 0
        self.lines = 0
        self.level = 1
        self.combo = -1
        self.b2b = False
        self.alive = True
        self.won = False
        self.saved = False
        self.paused = False
        self.last_rotate = False
        self.lock_resets = 0
        self.lock_until = 0.0
        self.clearing: list[int] = []
        self.clear_until = 0.0
        self.banner = ""
        self.banner_until = 0.0
        self.started = time.monotonic()
        self.elapsed_ms = 0
        self.ended_at: Optional[float] = None
        self.pending_tspin = False
        self.pause_started = 0.0
        self.was_grounded = False
        self.just_landed = False
        self.just_scored = 0
        self.piece = self.spawn()

    def spawn_piece(self, kind: str) -> Optional[Piece]:
        piece = Piece(kind)
        if self.board.fits(piece):
            return piece
        piece.y -= 1
        if self.board.fits(piece):
            return piece
        return None

    def spawn(self) -> Optional[Piece]:
        kind = self.next.pop(0)
        self.next.append(self.bag.take())
        piece = self.spawn_piece(kind)
        self.hold_used = False
        self.last_rotate = False
        self.lock_resets = 0
        self.lock_until = 0.0
        self.was_grounded = False
        self.just_landed = False
        self.gravity_at = time.monotonic() + gravity_ms(self.level) / 1000.0
        if piece is None:
            self.finish(False)
        return piece

    def finish(self, won: bool) -> None:
        if not self.alive:
            return
        self.alive = False
        self.won = won
        self.ended_at = time.monotonic()
        self.elapsed_ms = int((self.ended_at - self.started) * 1000)

    def remaining_ms(self) -> int:
        if self.mode != "ultra":
            return 0
        used = self.clock_ms()
        return max(0, ULTRA_MS - used)

    def clock_ms(self) -> int:
        if self.ended_at is not None:
            return int((self.ended_at - self.started) * 1000)
        if self.paused:
            return self.elapsed_ms
        return int((time.monotonic() - self.started) * 1000)

    def ghost(self) -> Optional[Piece]:
        if self.piece is None:
            return None
        ghost = self.piece.copy()
        while True:
            ghost.y += 1
            if not self.board.fits(ghost):
                ghost.y -= 1
                return ghost

    def try_move(self, dx: int, dy: int) -> bool:
        if self.piece is None or not self.alive or self.paused or self.clearing:
            return False
        nxt = self.piece.copy()
        nxt.x += dx
        nxt.y += dy
        if not self.board.fits(nxt):
            return False
        self.piece = nxt
        self.last_rotate = False
        self.note_landing()
        self.touch_lock(moved=True)
        return True

    def try_rotate(self, delta: int) -> bool:
        if self.piece is None or not self.alive or self.paused or self.clearing:
            return False
        start = self.piece.rot
        dest = (start + delta) % 4
        kicks = [(0, 0)]
        if self.piece.kind == "I":
            kicks = KICKS_I.get((start, dest), kicks)
        elif self.piece.kind != "O":
            kicks = KICKS_JLSTZ.get((start, dest), kicks)
        for kx, ky in kicks:
            nxt = self.piece.copy()
            nxt.rot = dest
            nxt.x += kx
            nxt.y += ky
            if self.board.fits(nxt):
                self.piece = nxt
                self.last_rotate = True
                self.note_landing()
                self.touch_lock(moved=True)
                return True
        return False

    def hard_drop(self) -> None:
        if self.piece is None or not self.alive or self.paused or self.clearing:
            return
        dist = 0
        while self.try_move(0, 1):
            dist += 1
        self.score += dist * 2
        self.lock_piece()
        self.just_landed = True

    def soft_drop(self) -> None:
        if self.try_move(0, 1):
            self.score += 1

    def swap_hold(self) -> None:
        if self.piece is None or self.hold_used or not self.alive or self.paused or self.clearing:
            return
        current = self.piece.kind
        if self.hold is None:
            self.hold = current
            self.piece = self.spawn()
        else:
            held = self.hold
            self.hold = current
            self.piece = self.spawn_piece(held)
            if self.piece is None:
                self.finish(False)
                return
            self.last_rotate = False
            self.lock_resets = 0
            self.lock_until = 0.0
            self.was_grounded = False
            self.just_landed = False
            self.gravity_at = time.monotonic() + gravity_ms(self.level) / 1000.0
        self.hold_used = True

    def grounded(self) -> bool:
        if self.piece is None:
            return False
        test = self.piece.copy()
        test.y += 1
        return not self.board.fits(test)

    def note_landing(self) -> None:
        now = self.grounded()
        if now and not self.was_grounded:
            self.just_landed = True
        self.was_grounded = now

    def consume_land(self) -> bool:
        hit = self.just_landed
        self.just_landed = False
        return hit

    def consume_score(self) -> int:
        hit = int(self.just_scored or 0)
        self.just_scored = 0
        return hit

    def touch_lock(self, moved: bool) -> None:
        if not self.grounded():
            self.lock_until = 0.0
            return
        if moved and self.lock_resets < MAX_LOCK_RESETS:
            self.lock_resets += 1
            self.lock_until = time.monotonic() + LOCK_MS / 1000.0
        elif self.lock_until == 0.0:
            self.lock_until = time.monotonic() + LOCK_MS / 1000.0

    def lock_piece(self) -> None:
        if self.piece is None:
            return
        tspin = self.piece.kind == "T" and self.last_rotate and self.board.occupied_corners(self.piece) >= 3
        self.board.lock(self.piece)
        rows = self.board.full_rows()
        if rows:
            self.just_scored = len(rows)
            self.clearing = rows
            self.clear_until = time.monotonic() + FLASH_MS / 1000.0
            self.pending_tspin = tspin
            self.piece = None
            return
        self.apply_clear(0, tspin)
        self.piece = self.spawn()

    def apply_clear(self, count: int, tspin: bool) -> None:
        difficult = count == 4 or (tspin and count > 0)
        awarded = 0
        label = ""
        if tspin:
            awarded = TSPIN_POINTS.get(count, 400) * self.level
            label = {0: "T-SPIN", 1: "T-SPIN SINGLE", 2: "T-SPIN DOUBLE", 3: "T-SPIN TRIPLE"}.get(count, "T-SPIN")
        elif count:
            awarded = LINE_POINTS[count] * self.level
            label = {1: "SINGLE", 2: "DOUBLE", 3: "TRIPLE", 4: "TETRIS"}[count]
        if count:
            if self.combo >= 0:
                awarded += 50 * self.combo * self.level
            self.combo += 1
            if self.combo >= 1:
                label = f"{label}  x{self.combo + 1}" if label else f"COMBO x{self.combo + 1}"
        else:
            self.combo = -1
        if difficult and self.b2b and awarded:
            awarded = int(awarded * 1.5)
            label = f"B2B {label}" if label else label
        if count:
            self.b2b = difficult
            self.lines += count
            self.level = 1 + self.lines // 10
        if awarded:
            self.score += awarded
        if label:
            self.banner = label
            self.banner_until = time.monotonic() + 1.1
        if self.mode == "sprint" and self.lines >= SPRINT_LINES:
            self.finish(True)
        self.pending_tspin = False

    def tick(self, now: float) -> None:
        if not self.alive or self.paused:
            return
        if self.mode == "ultra" and self.remaining_ms() <= 0:
            self.finish(True)
            return
        if self.clearing:
            if now >= self.clear_until:
                count = len(self.clearing)
                self.board.clear_rows(self.clearing)
                self.clearing = []
                self.apply_clear(count, self.pending_tspin)
                if self.alive:
                    self.piece = self.spawn()
            return
        if self.piece is None:
            return
        if self.grounded():
            if self.lock_until == 0.0:
                self.touch_lock(moved=False)
            elif now >= self.lock_until:
                self.lock_piece()
            return
        if now >= self.gravity_at:
            self.try_move(0, 1)
            self.gravity_at = now + gravity_ms(self.level) / 1000.0

    def toggle_pause(self) -> None:
        if not self.alive:
            return
        if self.paused:
            paused_for = time.monotonic() - self.pause_started
            self.started += paused_for
            self.gravity_at += paused_for
            if self.lock_until:
                self.lock_until += paused_for
            if self.clear_until:
                self.clear_until += paused_for
            self.paused = False
        else:
            self.elapsed_ms = self.clock_ms()
            self.pause_started = time.monotonic()
            self.paused = True


def ansi_fg(rgb: tuple[int, int, int]) -> str:
    return f"\x1b[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def ansi_bg(rgb: tuple[int, int, int]) -> str:
    return f"\x1b[48;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def paint(text: str, fg: tuple[int, int, int], bg: Optional[tuple[int, int, int]] = None) -> str:
    out = ansi_fg(fg)
    if bg is not None:
        out += ansi_bg(bg)
    return out + text


RESET = "\x1b[0m"


def fmt_score(n: int) -> str:
    return f"{n:,}".replace(",", " ")


def fmt_time(ms: int) -> str:
    ms = max(0, ms)
    minutes, rem = divmod(ms // 1000, 60)
    seconds = rem
    hundredths = (ms % 1000) // 10
    return f"{minutes}:{seconds:02d}.{hundredths:02d}"


def player_name() -> str:
    name = os.environ.get("USER") or os.environ.get("LOGNAME") or "player"
    return name[:12]


def fmt_when(stamp: str) -> str:
    try:
        parsed = time.strptime(stamp.strip(), "%Y-%m-%d %H:%M")
        return time.strftime("%d %b %H:%M", parsed)
    except ValueError:
        return stamp[:14]


def volume_bar(volume: int, width: int = 16) -> str:
    fill = int(round(max(0, min(100, volume)) / 100 * width))
    return "█" * fill + "░" * (width - fill)


def score_line(mode: str, row: dict) -> str:
    name = str(row.get("name") or player_name())[:12]
    when = fmt_when(str(row.get("at") or ""))
    if mode == "sprint":
        value = fmt_time(int(row.get("time_ms", 0))) if row.get("finished") else "—"
    else:
        value = fmt_score(int(row.get("score", 0)))
    return f"{name:<12}  {value:>8}  {when}"


def term_size() -> tuple[int, int]:
    try:
        size = os.get_terminal_size()
        return size.columns, size.lines
    except OSError:
        return 80, 24


class Screen:
    def __init__(self, theme: Theme) -> None:
        self.theme = theme
        self.cols, self.rows = term_size()

    def refresh_size(self) -> None:
        self.cols, self.rows = term_size()

    def fill_line(self, width: int, bg: tuple[int, int, int]) -> str:
        return paint(" " * width, self.theme.fg, bg) + RESET


class App:
    def __init__(self) -> None:
        self.theme = Theme()
        self.screen = Screen(self.theme)
        self.scores = Scores()
        self.settings = Settings()
        self.sound = Sound(self.settings)
        self.music = Music(self.settings)
        self.page = "menu"
        self.menu_index = 0
        self.game: Optional[Game] = None
        self.running = True
        self.old_term: Optional[list] = None
        self.buf = bytearray()
        self.celebrate_mode: Optional[str] = None
        self.celebrate_until = 0.0
        self.vol_flash_until = 0.0
        self.vol_flash = "game"

    def start_mode(self, mode: str) -> None:
        self.game = Game(mode)
        self.page = "play"

    def record_score(self) -> None:
        game = self.game
        if game is None:
            return
        row = {
            "name": player_name(),
            "score": game.score,
            "lines": game.lines,
            "level": game.level,
            "time_ms": game.clock_ms(),
            "finished": bool(game.won),
            "at": time.strftime("%Y-%m-%d %H:%M"),
        }
        _rank, record = self.scores.add(game.mode, row)
        if record:
            self.celebrate_mode = game.mode
            self.celebrate_until = time.monotonic() + 8.0

    def read_keys(self, timeout: float) -> list[str]:
        keys: list[str] = []
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if ready:
            try:
                chunk = os.read(sys.stdin.fileno(), 64)
            except OSError:
                chunk = b""
            self.buf.extend(chunk)
        data = bytes(self.buf)
        self.buf.clear()
        i = 0
        while i < len(data):
            b = data[i]
            if b == 0x1B:
                if i + 2 < len(data) and data[i + 1] == ord("["):
                    code = data[i + 2]
                    mapping = {ord("A"): "up", ord("B"): "down", ord("C"): "right", ord("D"): "left"}
                    keys.append(mapping.get(code, "esc"))
                    i += 3
                    continue
                if i + 1 == len(data):
                    keys.append("esc")
                    i += 1
                    continue
                keys.append("esc")
                i += 1
                continue
            if b in (3,):
                keys.append("quit")
            elif b in (13, 10):
                keys.append("enter")
            elif b == 32:
                keys.append("space")
            elif b in (127, 8):
                keys.append("back")
            else:
                ch = chr(b).lower()
                names = {
                    "a": "left",
                    "d": "right",
                    "s": "down",
                    "w": "up",
                    "x": "up",
                    "z": "ccw",
                    "c": "hold",
                    "p": "pause",
                    "q": "quit",
                    "r": "retry",
                    "h": "left",
                    "l": "right",
                    "j": "down",
                    "k": "up",
                    "n": "sound",
                    "t": "theme",
                    "m": "mute",
                    "[": "sfx-",
                    "]": "sfx+",
                    "-": "mus-",
                    "_": "mus-",
                    "=": "mus+",
                    "+": "mus+",
                    ",": "mus-",
                    ".": "mus+",
                }
                keys.append(names.get(ch, ch))
            i += 1
        return keys

    def handle_menu(self, keys: list[str]) -> None:
        for key in keys:
            if key in ("up", "k"):
                self.menu_index = (self.menu_index - 1) % len(MODES)
            elif key in ("down", "j"):
                self.menu_index = (self.menu_index + 1) % len(MODES)
            elif key in ("enter", "space"):
                self.start_mode(MODES[self.menu_index])
            elif key in ("1", "2", "3"):
                self.menu_index = int(key) - 1
                self.start_mode(MODES[self.menu_index])
            elif key in ("sound", "n"):
                self.settings.cycle_sound()
                self.sound.play()
            elif key in ("theme", "t"):
                self.settings.cycle_theme()
            elif key in ("mute", "m"):
                self.settings.toggle_music()
            elif key in ("sfx-", "["):
                self.settings.nudge_sound(-5)
                self.sound.play()
                self.vol_flash = "game"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("sfx+", "]"):
                self.settings.nudge_sound(5)
                self.sound.play()
                self.vol_flash = "game"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("mus-", "-", ","):
                self.settings.nudge_music(-5)
                self.vol_flash = "music"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("mus+", "=", ".", "+"):
                self.settings.nudge_music(5)
                self.vol_flash = "music"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("quit", "esc", "q"):
                self.running = False

    def handle_play(self, keys: list[str]) -> None:
        game = self.game
        if game is None:
            return
        if not game.alive:
            for key in keys:
                if key in ("enter", "retry", "r", "space"):
                    if not game.saved:
                        self.record_score()
                        game.saved = True
                    self.start_mode(game.mode)
                    return
                if key in ("quit", "esc", "q"):
                    if not game.saved:
                        self.record_score()
                        game.saved = True
                    self.page = "menu"
                    return
            return
        for key in keys:
            if key in ("pause", "p", "esc"):
                game.toggle_pause()
                continue
            if game.paused:
                if key in ("theme", "t"):
                    self.settings.cycle_theme()
                elif key in ("mute", "m"):
                    self.settings.toggle_music()
                elif key in ("quit", "q"):
                    self.record_if_needed()
                    self.page = "menu"
                    return
                elif key in ("retry", "r"):
                    self.record_if_needed()
                    self.start_mode(game.mode)
                    return
                continue
            if key == "left":
                game.try_move(-1, 0)
            elif key == "right":
                game.try_move(1, 0)
            elif key == "down":
                game.soft_drop()
            elif key == "up":
                game.try_rotate(1)
            elif key == "ccw":
                game.try_rotate(-1)
            elif key == "space":
                game.hard_drop()
            elif key == "hold":
                game.swap_hold()
            elif key in ("sound", "n"):
                self.settings.cycle_sound()
                self.sound.play()
            elif key in ("theme", "t"):
                self.settings.cycle_theme()
            elif key in ("mute", "m"):
                self.settings.toggle_music()
            elif key in ("sfx-", "["):
                self.settings.nudge_sound(-5)
                self.vol_flash = "game"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("sfx+", "]"):
                self.settings.nudge_sound(5)
                self.vol_flash = "game"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("mus-", "-", ","):
                self.settings.nudge_music(-5)
                self.vol_flash = "music"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("mus+", "=", ".", "+"):
                self.settings.nudge_music(5)
                self.vol_flash = "music"
                self.vol_flash_until = time.monotonic() + 1.2
            elif key in ("retry", "r"):
                self.record_if_needed()
                self.start_mode(game.mode)
                return
            elif key == "quit":
                self.record_if_needed()
                self.page = "menu"
                return

    def record_if_needed(self) -> None:
        game = self.game
        if game is None or game.saved:
            return
        if game.score > 0 or game.lines > 0:
            if game.alive and game.clock_ms() > 1500:
                game.finish(False)
            if not game.alive:
                self.record_score()
                game.saved = True

    def min_size(self) -> tuple[int, int]:
        return (64, 26) if self.page == "menu" else (56, 24)

    def celebrating(self, mode: str) -> bool:
        return self.celebrate_mode == mode and time.monotonic() < self.celebrate_until

    def paint_canvas(self, canvas: list[list[tuple[str, tuple[int, int, int], tuple[int, int, int]]]]) -> list[str]:
        lines: list[str] = []
        for y in range(len(canvas)):
            parts: list[str] = []
            last_fg = None
            last_bg = None
            run: list[str] = []

            def flush() -> None:
                if not run:
                    return
                parts.append(paint("".join(run), last_fg, last_bg))
                run.clear()

            for ch, fg, bgc in canvas[y]:
                if fg != last_fg or bgc != last_bg:
                    flush()
                    last_fg, last_bg = fg, bgc
                run.append(ch)
            flush()
            parts.append(RESET)
            lines.append("".join(parts))
        return lines

    def draw(self) -> None:
        self.screen.refresh_size()
        cols, rows = self.screen.cols, self.screen.rows
        need_w, need_h = self.min_size()
        bg = self.theme.bg
        lines: list[str] = []
        if cols < need_w or rows < need_h:
            msg = f"Need at least {need_w}x{need_h}  (now {cols}x{rows})"
            for y in range(rows):
                if y == rows // 2:
                    pad = max(0, (cols - len(msg)) // 2)
                    text = " " * pad + msg
                    text = text[:cols].ljust(cols)
                    lines.append(paint(text, self.theme.fg, bg) + RESET)
                else:
                    lines.append(self.screen.fill_line(cols, bg))
            self.blit(lines)
            return
        if self.page == "menu":
            lines = self.draw_menu(cols, rows, bg)
        else:
            lines = self.draw_play(cols, rows, bg)
        self.blit(lines)

    def blit(self, lines: list[str]) -> None:
        rows = self.screen.rows
        cols = self.screen.cols
        while len(lines) < rows:
            lines.append(self.screen.fill_line(cols, self.theme.bg))
        sys.stdout.write("\x1b[H" + "\n".join(lines[:rows]))
        sys.stdout.flush()

    def draw_menu(self, cols: int, rows: int, bg: tuple[int, int, int]) -> list[str]:
        theme = self.theme
        card_w = min(CARD_W, max(36, cols - 4))
        left = max(0, (cols - card_w) // 2)
        inner_w = card_w - 4
        selected_mode = MODES[self.menu_index]
        board = self.scores.rows(selected_mode)
        board_h = max(1, len(board))
        height = 18 + board_h
        top = max(1, (rows - height) // 2)
        canvas = [[(" ", theme.fg, bg) for _ in range(cols)] for _ in range(rows)]

        def put(x: int, y: int, ch: str, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            if 0 <= y < rows and 0 <= x < cols:
                canvas[y][x] = (ch[:1], fg, bgc)

        def put_str(x: int, y: int, text: str, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            for i, ch in enumerate(text):
                put(x + i, y, ch, fg, bgc)

        def fill(x: int, y: int, width: int, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            put_str(x, y, " " * max(0, width), fg, bgc)

        letters = [
            ("T", theme.piece("T")),
            ("E", theme.piece("I")),
            ("T", theme.piece("O")),
            ("R", theme.piece("Z")),
            ("I", theme.piece("J")),
            ("S", theme.piece("S")),
        ]
        title = "  ".join(ch for ch, _ in letters)
        title_x = left + max(0, (card_w - len(title)) // 2)
        for i, (ch, color) in enumerate(letters):
            put(title_x + i * 3, top, ch, color, bg)

        box_y = top + 2
        box_h = 10
        well = theme.well
        put_str(left, box_y, "╭" + "─" * (card_w - 2) + "╮", theme.muted, well)
        for row in range(1, box_h - 1):
            put(left, box_y + row, "│", theme.muted, well)
            fill(left + 1, box_y + row, card_w - 2, theme.fg, well)
            put(left + card_w - 1, box_y + row, "│", theme.muted, well)
        put_str(left, box_y + box_h - 1, "╰" + "─" * (card_w - 2) + "╯", theme.muted, well)

        for i, mode in enumerate(MODES):
            y = box_y + 1 + i * 3
            selected = i == self.menu_index
            row_bg = mix(theme.selection, well, 0.62) if selected else well
            ink = theme.accent if selected else theme.fg
            dim = theme.accent if selected else theme.muted
            if selected:
                fill(left + 1, y, card_w - 2, ink, row_bg)
                fill(left + 1, y + 1, card_w - 2, dim, row_bg)
            mark = "▸ " if selected else "  "
            put_str(left + 2, y, f"{mark}{MODE_LABEL[mode]}", ink, row_bg)
            put_str(left + 4, y + 1, MODE_BLURB[mode][:inner_w], dim, row_bg)

        vol_y = box_y + box_h + 1

        def draw_bar(y: int, label: str, value: int) -> None:
            bar = volume_bar(value, 14)
            percent = "off" if value <= 0 else f"{value}%"
            text = f"{label:<5} {bar}  {percent}"
            x = left + max(0, (card_w - len(text)) // 2)
            put_str(x, y, f"{label:<5} ", theme.muted, bg)
            bx = x + 6
            for i, ch in enumerate(bar):
                color = theme.accent if ch == "█" else theme.muted
                put(bx + i, y, ch, color, bg)
            put_str(bx + len(bar) + 2, y, percent, theme.fg, bg)

        draw_bar(vol_y, "game", self.settings.sound_volume)
        music_value = 0 if self.settings.music_muted else self.settings.music_volume
        draw_bar(vol_y + 1, "music", music_value)
        music = MUSIC_LABEL.get(self.settings.theme, self.settings.theme)
        state = "muted" if self.settings.music_muted else music
        extra = f"{self.settings.sound}   {state}"
        put_str(left + max(0, (card_w - len(extra)) // 2), vol_y + 2, extra, theme.muted, bg)

        board_y = vol_y + 4
        heading = f"board  ·  {MODE_LABEL[selected_mode]}"
        put_str(left + max(0, (card_w - len(heading)) // 2), board_y, heading, theme.muted, bg)
        if board:
            for index, row in enumerate(board):
                mark = "♔ " if index == 0 else f"{index + 1} "
                line = f"  {mark}{score_line(selected_mode, row)}"
                color = theme.accent if index == 0 else theme.muted
                put_str(left + 2, board_y + 1 + index, line[: card_w - 2], color, bg)
        else:
            empty = "no games yet"
            put_str(left + max(0, (card_w - len(empty)) // 2), board_y + 1, empty, theme.muted, bg)

        hint = "enter   t music theme   m mute   [ ] game   - = music   q"
        put_str(left + max(0, (card_w - len(hint)) // 2), min(rows - 1, board_y + board_h + 2), hint, theme.muted, bg)
        return self.paint_canvas(canvas)

    def draw_play(self, cols: int, rows: int, bg: tuple[int, int, int]) -> list[str]:
        game = self.game
        assert game is not None
        theme = self.theme
        well_w = COLS * CELL + 2
        side = 14
        gap = 2
        total_w = side + gap + well_w + gap + side
        left0 = max(1, (cols - total_w) // 2)
        well0 = left0 + side + gap
        right0 = well0 + well_w + gap
        header_y = max(0, (rows - (ROWS + 3)) // 2)
        well_y = header_y + 2
        canvas = [[(" ", theme.fg, bg) for _ in range(cols)] for _ in range(rows)]

        def put(x: int, y: int, ch: str, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            if 0 <= y < rows and 0 <= x < cols:
                canvas[y][x] = (ch[:1], fg, bgc)

        def put_str(x: int, y: int, text: str, fg: tuple[int, int, int], bgc: tuple[int, int, int]) -> None:
            for i, ch in enumerate(text):
                put(x + i, y, ch, fg, bgc)

        def put_cell(x: int, y: int, color: tuple[int, int, int], ghost: bool = False, filled: bool = True) -> None:
            if not filled:
                put(x, y, " ", theme.fg, color)
                put(x + 1, y, " ", theme.fg, color)
                return
            seam = theme.grout
            if ghost:
                dust = mix(color, theme.well, 0.3)
                put(x, y, "▄", dust, theme.well)
                put(x + 1, y, "▖", dust, theme.well)
                return
            face = mix((255, 255, 255), color, 0.14)
            put(x, y, "▄", face, seam)
            put(x + 1, y, "▖", color, seam)

        title = f"TETRIS  ·  {MODE_LABEL[game.mode]}"
        put_str(well0, header_y, title, theme.accent, bg)

        for y in range(ROWS):
            put(well0, well_y + y, "│", theme.muted, theme.well)
            put(well0 + well_w - 1, well_y + y, "│", theme.muted, theme.well)
            for x in range(COLS):
                shade = theme.well_alt if (x + y) % 2 else theme.well
                put_cell(well0 + 1 + x * CELL, well_y + y, shade, filled=False)
        put_str(well0, well_y - 1, "╭" + "─" * (well_w - 2) + "╮", theme.muted, theme.well)
        put_str(well0, well_y + ROWS, "╰" + "─" * (well_w - 2) + "╯", theme.muted, theme.well)

        for y in range(ROWS):
            for x in range(COLS):
                kind = game.board.grid[y][x]
                if kind:
                    color = theme.piece(kind)
                    if y in game.clearing:
                        color = mix(theme.rgb("bright_foreground"), color, 0.75)
                    put_cell(well0 + 1 + x * CELL, well_y + y, color)

        if game.piece and game.alive and not game.paused:
            ghost = game.ghost()
            if ghost:
                for x, y in ghost.blocks():
                    if 0 <= y < ROWS:
                        put_cell(well0 + 1 + x * CELL, well_y + y, theme.piece(game.piece.kind), ghost=True)
            for x, y in game.piece.blocks():
                if 0 <= y < ROWS:
                    put_cell(well0 + 1 + x * CELL, well_y + y, theme.piece(game.piece.kind))

        def mini(kind: Optional[str], ox: int, oy: int) -> None:
            box_w = 12
            put_str(ox, oy, "╭" + "─" * (box_w - 2) + "╮", theme.muted, bg)
            for row in range(2):
                put(ox, oy + 1 + row, "│", theme.muted, bg)
                put_str(ox + 1, oy + 1 + row, " " * (box_w - 2), theme.fg, theme.well)
                put(ox + box_w - 1, oy + 1 + row, "│", theme.muted, bg)
            put_str(ox, oy + 3, "╰" + "─" * (box_w - 2) + "╯", theme.muted, bg)
            if not kind:
                return
            blocks = SHAPES[kind][0]
            minx = min(b[0] for b in blocks)
            miny = min(b[1] for b in blocks)
            maxx = max(b[0] for b in blocks)
            maxy = max(b[1] for b in blocks)
            pw = (maxx - minx + 1) * CELL
            ph = maxy - miny + 1
            sx = ox + 1 + max(0, (box_w - 2 - pw) // 2)
            sy = oy + 1 + max(0, (2 - ph) // 2)
            for cx, cy in blocks:
                put_cell(sx + (cx - minx) * CELL, sy + (cy - miny), theme.piece(kind))

        put_str(left0, well_y - 1, "HOLD", theme.muted, bg)
        mini(game.hold, left0, well_y)
        put_str(left0, well_y + 5, "SCORE", theme.muted, bg)
        put_str(left0, well_y + 6, fmt_score(game.score), theme.fg, bg)
        put_str(left0, well_y + 8, "LEVEL", theme.muted, bg)
        put_str(left0, well_y + 9, str(game.level), theme.fg, bg)
        put_str(left0, well_y + 11, "LINES", theme.muted, bg)
        if game.mode == "sprint":
            put_str(left0, well_y + 12, f"{min(game.lines, SPRINT_LINES)} / {SPRINT_LINES}", theme.fg, bg)
        else:
            put_str(left0, well_y + 12, str(game.lines), theme.fg, bg)
        if game.mode == "ultra":
            put_str(left0, well_y + 14, "TIME", theme.muted, bg)
            put_str(left0, well_y + 15, fmt_time(game.remaining_ms()), theme.accent, bg)
        elif game.mode == "sprint":
            put_str(left0, well_y + 14, "TIME", theme.muted, bg)
            put_str(left0, well_y + 15, fmt_time(game.clock_ms()), theme.accent, bg)
        if time.monotonic() < self.vol_flash_until:
            if self.vol_flash == "music":
                value = 0 if self.settings.music_muted else self.settings.music_volume
                label = "music"
            else:
                value = self.settings.sound_volume
                label = "game"
            bar = volume_bar(value, 10)
            percent = "off" if value <= 0 else f"{value}%"
            put_str(left0, well_y + 17, f"{label} {bar} {percent}", theme.accent, bg)
        elif game.banner and time.monotonic() < game.banner_until:
            put_str(left0, well_y + 17, game.banner, theme.accent, bg)

        put_str(right0, well_y - 1, "NEXT", theme.muted, bg)
        for i, kind in enumerate(game.next):
            mini(kind, right0, well_y + i * 4)

        help_y = min(rows - 1, well_y + ROWS + 1)
        help_txt = "←→ move   space drop   [ ] game   - = music   m mute   p pause"
        put_str(max(0, (cols - len(help_txt)) // 2), help_y, help_txt, theme.muted, bg)

        overlay = ""
        record = self.celebrating(game.mode)
        if game.paused:
            overlay = "PAUSED"
            sub = "p resume   r retry   q menu"
        elif not game.alive:
            if game.mode == "sprint" and game.won:
                overlay = "RECORD" if record else "CLEARED"
                sub = f"{fmt_time(game.clock_ms())}    enter retry   q menu"
            elif game.mode == "ultra":
                overlay = "RECORD" if record else ("TIME UP" if game.won else "TOP OUT")
                sub = f"{fmt_score(game.score)}    enter retry   q menu"
            else:
                overlay = "RECORD" if record else "GAME OVER"
                sub = f"{fmt_score(game.score)}    enter retry   q menu"
        if overlay:
            title = f"♔ {overlay}" if record else overlay
            box_w = max(len(title), len(sub)) + 6
            box_h = 5
            ox = well0 + (well_w - box_w) // 2
            oy = well_y + (ROWS - box_h) // 2
            panel = mix(theme.rgb("darker_background"), theme.selection, 0.55)
            for yy in range(box_h):
                for xx in range(box_w):
                    put(ox + xx, oy + yy, " ", theme.fg, panel)
            put_str(ox + (box_w - len(title)) // 2, oy + 1, title, theme.accent, panel)
            put_str(ox + (box_w - len(sub)) // 2, oy + 3, sub, theme.fg, panel)

        return self.paint_canvas(canvas)

    def setup_term(self) -> None:
        self.old_term = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b]0;Tetris\x07")
        sys.stdout.flush()

    def restore_term(self) -> None:
        sys.stdout.write("\x1b[?7h\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if self.old_term is not None:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.old_term)

    def run(self) -> int:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            sys.stderr.write("omarchy-tetris needs an interactive terminal\n")
            return 1
        try:
            sys.stdout.reconfigure(encoding="utf-8")
        except Exception:
            pass
        self.setup_term()

        def handle_int(_sig, _frame) -> None:
            self.running = False

        signal.signal(signal.SIGINT, handle_int)
        signal.signal(signal.SIGTERM, handle_int)
        self.music.start()
        try:
            while self.running:
                self.theme.reload()
                self.settings.load()
                now = time.monotonic()
                if self.page == "play" and self.game is not None:
                    self.game.tick(now)
                    if self.game.consume_land():
                        self.sound.play()
                    cleared = self.game.consume_score()
                    if cleared:
                        self.sound.play(self.sound.clear_voice(cleared))
                    if not self.game.alive and not self.game.saved:
                        self.record_score()
                        self.game.saved = True
                self.draw()
                keys = self.read_keys(TICK)
                if self.page == "menu":
                    self.handle_menu(keys)
                else:
                    self.handle_play(keys)
        finally:
            self.music.stop()
            self.restore_term()
        return 0


def parse_args(argv: list[str]) -> dict:
    out = {"preview": False, "sound": None, "volume": None}
    args = list(argv[1:])
    while args:
        item = args.pop(0)
        if item in ("-h", "--help"):
            sys.stdout.write(
                "usage: omarchy-tetris [--preview] [--sound thock|click|chip|hush|clear] [--volume 0-100]\n"
            )
            raise SystemExit(0)
        if item == "--preview":
            out["preview"] = True
        elif item == "--sound" and args:
            out["sound"] = args.pop(0)
        elif item == "--volume" and args:
            out["volume"] = args.pop(0)
        else:
            sys.stderr.write(f"unknown argument: {item}\n")
            raise SystemExit(2)
    return out


def main() -> int:
    opts = parse_args(sys.argv)
    if opts["preview"]:
        settings = Settings()
        if opts["sound"] in SOUND_VOICES or opts["sound"] == "clear":
            settings.sound = opts["sound"]
        if opts["volume"] is not None:
            try:
                settings.sound_volume = max(0, min(100, int(opts["volume"])))
            except ValueError:
                pass
        Sound(settings).play()
        time.sleep(0.18)
        return 0
    return App().run()


if __name__ == "__main__":
    raise SystemExit(main())
