class Piece:
    def __init__(self, kind: str) -> None:
        self.kind = kind
        self.rot = 0
        self.x = 3
        self.y = -1

    def copy(self) -> Piece:
        piece = Piece(self.kind)
        piece.rot = self.rot
        piece.x = self.x
        piece.y = self.y
        return piece

    def blocks(self) -> list[tuple[int, int]]:
        return cells(self.kind, self.rot, self.x, self.y)


class Board:
    def __init__(self) -> None:
        self.grid: list[list[Optional[str]]] = [[None] * COLS for _ in range(ROWS)]

    def inside(self, x: int, y: int) -> bool:
        return 0 <= x < COLS and y < ROWS

    def free(self, x: int, y: int) -> bool:
        if y < 0:
            return 0 <= x < COLS
        return self.inside(x, y) and self.grid[y][x] is None

    def fits(self, piece: Piece) -> bool:
        return all(self.free(x, y) for x, y in piece.blocks())

    def lock(self, piece: Piece) -> None:
        for x, y in piece.blocks():
            if 0 <= y < ROWS and 0 <= x < COLS:
                self.grid[y][x] = piece.kind

    def full_rows(self) -> list[int]:
        return [y for y in range(ROWS) if all(self.grid[y][x] is not None for x in range(COLS))]

    def clear_rows(self, rows: list[int]) -> None:
        keep = [self.grid[y] for y in range(ROWS) if y not in set(rows)]
        pad = [[None] * COLS for _ in range(len(rows))]
        self.grid = pad + keep

    def occupied_corners(self, piece: Piece) -> int:
        cx, cy = piece.x + 1, piece.y + 1
        count = 0
        for x, y in ((cx - 1, cy - 1), (cx + 1, cy - 1), (cx - 1, cy + 1), (cx + 1, cy + 1)):
            if y < 0:
                continue
            if not self.inside(x, y) or self.grid[y][x] is not None:
                count += 1
        return count


class Scores:
    def __init__(self) -> None:
        self.data = {mode: [] for mode in MODES}
        self.load()

    def load(self) -> None:
        try:
            raw = json.loads(SCORE_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return
        if not isinstance(raw, dict):
            return
        for mode in MODES:
            rows = raw.get(mode, [])
            if isinstance(rows, list):
                self.data[mode] = [row for row in rows if isinstance(row, dict)][:8]

    def save(self) -> None:
        SCORE_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = SCORE_PATH.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.data, indent=2) + "\n", encoding="utf-8")
        tmp.replace(SCORE_PATH)

    def beats(self, mode: str, row: dict, best: Optional[dict]) -> bool:
        if best is None:
            return True
        if mode == "sprint":
            if not row.get("finished"):
                return False
            if not best.get("finished"):
                return True
            return int(row.get("time_ms", 10**9)) < int(best.get("time_ms", 10**9))
        return int(row.get("score", 0)) > int(best.get("score", 0))

    def add(self, mode: str, row: dict) -> tuple[int, bool]:
        record = self.beats(mode, row, self.best(mode))
        bucket = list(self.data.get(mode, []))
        bucket.append(row)
        if mode == "sprint":
            bucket.sort(key=lambda item: (0 if item.get("finished") else 1, item.get("time_ms", 1_000_000_000)))
        else:
            bucket.sort(key=lambda item: -int(item.get("score", 0)))
        self.data[mode] = bucket[:8]
        self.save()
        rank = 0
        for index, item in enumerate(self.data[mode]):
            if item is row or item == row:
                rank = index
                break
        return rank, record

    def best(self, mode: str) -> Optional[dict]:
        rows = self.data.get(mode) or []
        return rows[0] if rows else None

    def rows(self, mode: str, limit: int = BOARD_ROWS) -> list[dict]:
        return list(self.data.get(mode) or [])[:limit]


class Settings:
    def __init__(self) -> None:
        self.sound = "thock"
        self.sound_volume = 55
        self.music_volume = 15
        self.theme = "piano"
        self.music_muted = False
        self.mtime = -1.0
        self.load()

    def load(self) -> bool:
        try:
            mtime = CONFIG_PATH.stat().st_mtime if CONFIG_PATH.is_file() else -1.0
        except OSError:
            mtime = -1.0
        if mtime == self.mtime and mtime != -1.0:
            return False
        self.mtime = mtime
        try:
            raw = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            raw = {}
        if not isinstance(raw, dict):
            raw = {}
        voice = str(raw.get("sound", "thock"))
        self.sound = voice if voice in SOUND_VOICES else "thock"
        theme = str(raw.get("theme", "piano"))
        self.theme = theme if theme in MUSIC_THEMES else "piano"
        self.music_muted = bool(raw.get("music_muted", False))
        legacy = raw.get("volume")
        self.sound_volume = self._clamp_vol(raw.get("sound_volume", legacy if legacy is not None else 55), 55)
        self.music_volume = self._clamp_vol(raw.get("music_volume", 15), 15)
        return True

    def _clamp_vol(self, value, fallback: int) -> int:
        try:
            return max(0, min(100, int(value)))
        except (TypeError, ValueError):
            return fallback

    def save(self) -> None:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = CONFIG_PATH.with_suffix(".json.tmp")
        tmp.write_text(
            json.dumps(
                {
                    "sound": self.sound,
                    "sound_volume": self.sound_volume,
                    "music_volume": self.music_volume,
                    "theme": self.theme,
                    "music_muted": self.music_muted,
                },
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
        tmp.replace(CONFIG_PATH)
        try:
            self.mtime = CONFIG_PATH.stat().st_mtime
        except OSError:
            pass

    def cycle_sound(self) -> str:
        index = SOUND_VOICES.index(self.sound) if self.sound in SOUND_VOICES else 0
        self.sound = SOUND_VOICES[(index + 1) % len(SOUND_VOICES)]
        self.save()
        return self.sound

    def cycle_theme(self) -> str:
        index = MUSIC_THEMES.index(self.theme) if self.theme in MUSIC_THEMES else 0
        self.theme = MUSIC_THEMES[(index + 1) % len(MUSIC_THEMES)]
        self.save()
        return self.theme

    def toggle_music(self) -> bool:
        self.music_muted = not self.music_muted
        self.save()
        return self.music_muted

    def nudge_sound(self, delta: int) -> int:
        self.sound_volume = max(0, min(100, self.sound_volume + delta))
        self.save()
        return self.sound_volume

    def nudge_music(self, delta: int) -> int:
        self.music_volume = max(0, min(100, self.music_volume + delta))
        self.save()
        return self.music_volume


class Sound:
    def __init__(self, settings: Settings) -> None:
        self.settings = settings
        self.player = self._player()
        self.children: list[subprocess.Popen] = []

    def _player(self) -> Optional[list[str]]:
        for name in ("pw-play", "paplay", "aplay"):
            path = shutil.which(name)
            if path:
                return [path]
        return None

    def path_for(self, voice: str) -> Path:
        return ROOT / "sounds" / f"{voice}.wav"

    def clear_voice(self, lines: int) -> str:
        n = min(7, max(1, int(lines)))
        name = f"clear-{n}"
        if self.path_for(name).is_file():
            return name
        return "clear"

    def play(self, voice: Optional[str] = None) -> None:
        if self.player is None or self.settings.sound_volume <= 0:
            return
        chosen = voice or self.settings.sound
        path = self.path_for(chosen)
        if not path.is_file():
            return
        command = list(self.player)
        if command[0].endswith("pw-play"):
            command.extend(["--volume", f"{self.settings.sound_volume / 100.0:.2f}"])
        elif command[0].endswith("paplay"):
            command.append(f"--volume={int(self.settings.sound_volume / 100.0 * 65536)}")
        command.append(str(path))
        try:
            self.children = [child for child in self.children if child.poll() is None]
            child = subprocess.Popen(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.children.append(child)
        except OSError:
            return


class Music:
    RATE = 44100
    CHANNELS = 2
    FRAME = 4
    CHUNK = 4096 * 4

    def __init__(self, settings: Settings) -> None:
        self.settings = settings
        self.running = False
        self.thread: Optional[threading.Thread] = None
        self.child: Optional[subprocess.Popen] = None
        self.pcm = b""
        self.loaded = ""
        self.cursor = 0
        self.lock = threading.Lock()

    def path_for(self, theme: str) -> Path:
        base = ROOT / "sounds" / "themes" / theme
        for ext in (".opus", ".ogg", ".mp3"):
            path = base.with_suffix(ext)
            if path.is_file():
                return path
        return base.with_suffix(".opus")

    def gain(self) -> float:
        if self.settings.music_muted or self.settings.music_volume <= 0:
            return 0.0
        return self.settings.music_volume / 100.0 * 0.22

    def start(self) -> None:
        if self.running:
            return
        self.running = True
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.running = False
        self._kill()
        if self.thread is not None:
            self.thread.join(timeout=0.8)
            self.thread = None

    def _kill(self) -> None:
        child = self.child
        self.child = None
        if child is None:
            return
        stdin = child.stdin
        child.stdin = None
        if stdin is not None:
            try:
                stdin.close()
            except (BrokenPipeError, OSError):
                pass
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=0.4)
            except subprocess.TimeoutExpired:
                child.kill()

    def _decode(self, path: Path) -> bytes:
        ffmpeg = shutil.which("ffmpeg")
        if ffmpeg is None:
            return b""
        try:
            proc = subprocess.run(
                [
                    ffmpeg,
                    "-v",
                    "error",
                    "-i",
                    str(path),
                    "-f",
                    "s16le",
                    "-acodec",
                    "pcm_s16le",
                    "-ac",
                    str(self.CHANNELS),
                    "-ar",
                    str(self.RATE),
                    "-",
                ],
                capture_output=True,
                check=True,
            )
        except (OSError, subprocess.CalledProcessError):
            return b""
        return proc.stdout

    def _ensure(self) -> bool:
        theme = self.settings.theme if self.settings.theme in MUSIC_THEMES else "piano"
        if theme == self.loaded and self.pcm:
            return True
        path = self.path_for(theme)
        raw = self._decode(path) if path.is_file() else b""
        if not raw:
            self.pcm = b""
            self.loaded = ""
            return False
        with self.lock:
            self.pcm = raw
            self.loaded = theme
            self.cursor = 0
        return True

    def _spawn(self) -> None:
        player = shutil.which("pw-cat")
        if player is None:
            return
        try:
            self.child = subprocess.Popen(
                [
                    player,
                    "--playback",
                    "--raw",
                    "--format",
                    "s16",
                    "--rate",
                    str(self.RATE),
                    "--channels",
                    str(self.CHANNELS),
                    "--volume",
                    "1.0",
                    "--media-role",
                    "Music",
                    "-",
                ],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            self.child = None

    def _scale(self, chunk: bytes, gain: float) -> bytes:
        if gain <= 0:
            return b"\x00" * len(chunk)
        if gain >= 0.999:
            return chunk
        samples = array.array("h")
        samples.frombytes(chunk)
        factor = int(gain * 256)
        for i, sample in enumerate(samples):
            value = (sample * factor) >> 8
            if value > 32767:
                value = 32767
            elif value < -32768:
                value = -32768
            samples[i] = value
        return samples.tobytes()

    def _read(self, size: int) -> bytes:
        with self.lock:
            pcm = self.pcm
            cursor = self.cursor
        if not pcm:
            return b"\x00" * size
        out = bytearray()
        while len(out) < size:
            take = min(size - len(out), len(pcm) - cursor)
            out.extend(pcm[cursor : cursor + take])
            cursor += take
            if cursor >= len(pcm):
                cursor = 0
        with self.lock:
            if self.pcm is pcm:
                self.cursor = cursor
        return bytes(out)

    def _loop(self) -> None:
        while self.running:
            if not self._ensure():
                time.sleep(0.2)
                continue
            if self.child is None or self.child.poll() is not None:
                self._spawn()
                if self.child is None or self.child.stdin is None:
                    time.sleep(0.2)
                    continue
                try:
                    for _ in range(6):
                        self.child.stdin.write(self._scale(self._read(self.CHUNK), self.gain()))
                    self.child.stdin.flush()
                except (BrokenPipeError, OSError):
                    self._kill()
                    time.sleep(0.05)
                    continue
            chunk = self._scale(self._read(self.CHUNK), self.gain())
            try:
                self.child.stdin.write(chunk)
                self.child.stdin.flush()
            except (BrokenPipeError, OSError):
                self._kill()
                time.sleep(0.05)


