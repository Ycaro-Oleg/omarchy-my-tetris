def hex_rgb(value: str) -> tuple[int, int, int]:
    text = value.strip().lstrip("#")
    if len(text) == 3:
        text = "".join(ch * 2 for ch in text)
    if len(text) != 6:
        return (128, 128, 128)
    return (int(text[0:2], 16), int(text[2:4], 16), int(text[4:6], 16))


def mix(a: tuple[int, int, int], b: tuple[int, int, int], t: float) -> tuple[int, int, int]:
    return (
        int(a[0] * t + b[0] * (1.0 - t)),
        int(a[1] * t + b[1] * (1.0 - t)),
        int(a[2] * t + b[2] * (1.0 - t)),
    )


def parse_toml_colors(path: Path) -> dict[str, str]:
    data = dict(FALLBACK)
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return data
    for match in re.finditer(r'^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"([^"]*)"', text, re.M):
        data[match.group(1)] = match.group(2)
    return data


class Theme:
    def __init__(self) -> None:
        self.name = "default"
        self.mtime = -1.0
        self.mode = "dark"
        self.colors: dict[str, tuple[int, int, int]] = {}
        self.reload(force=True)

    def rgb(self, key: str) -> tuple[int, int, int]:
        return self.colors.get(key, hex_rgb(FALLBACK.get(key, "#888888")))

    def reload(self, force: bool = False) -> bool:
        try:
            mtime = THEME_PATH.stat().st_mtime if THEME_PATH.is_file() else -1.0
        except OSError:
            mtime = -1.0
        if not force and mtime == self.mtime:
            return False
        raw = parse_toml_colors(THEME_PATH) if THEME_PATH.is_file() else dict(FALLBACK)
        self.mtime = mtime
        self.mode = raw.get("mode", "dark")
        self.colors = {key: hex_rgb(value) for key, value in raw.items() if key != "mode"}
        try:
            self.name = THEME_NAME_PATH.read_text(encoding="utf-8").strip() or "theme"
        except OSError:
            self.name = THEME_PATH.parent.name if THEME_PATH.exists() else "theme"
        return True

    @property
    def bg(self) -> tuple[int, int, int]:
        return self.rgb("background")

    @property
    def well(self) -> tuple[int, int, int]:
        return self.rgb("dark_background")

    @property
    def well_alt(self) -> tuple[int, int, int]:
        return mix(self.rgb("lighter_background"), self.rgb("dark_background"), 0.22)

    @property
    def fg(self) -> tuple[int, int, int]:
        return self.rgb("foreground")

    @property
    def muted(self) -> tuple[int, int, int]:
        return self.rgb("muted")

    @property
    def accent(self) -> tuple[int, int, int]:
        return self.rgb("accent")

    @property
    def selection(self) -> tuple[int, int, int]:
        return self.rgb("selection")

    def piece(self, name: str) -> tuple[int, int, int]:
        mapping = {
            "I": "cyan",
            "O": "yellow",
            "T": "magenta",
            "S": "green",
            "Z": "red",
            "J": "blue",
            "L": "orange",
        }
        return self.rgb(mapping.get(name, "accent"))


def gravity_ms(level: int) -> int:
    n = max(1, level)
    seconds = (0.8 - (n - 1) * 0.007) ** (n - 1)
    return max(16, int(seconds * 1000))


def cells(kind: str, rot: int, x: int, y: int) -> list[tuple[int, int]]:
    return [(x + cx, y + cy) for cx, cy in SHAPES[kind][rot % 4]]


class Bag:
    def __init__(self) -> None:
        self.pool: list[str] = []

    def take(self) -> str:
        if not self.pool:
            self.pool = list("IOTSZJL")
            random.shuffle(self.pool)
        return self.pool.pop()


class Piece:
    def __init__(self, kind: str) -> None:
        self.kind = kind
        self.rot = 0
        self.x = 3
        self.y = -1

    def copy(self) -> Piece:
        piece = Piece(self.kind)
        piece.rot = self.rot
        piece.x = self.x
        piece.y = self.y
        return piece

    def blocks(self) -> list[tuple[int, int]]:
        return cells(self.kind, self.rot, self.x, self.y)


class Board:
    def __init__(self) -> None:
        self.grid: list[list[Optional[str]]] = [[None] * COLS for _ in range(ROWS)]

    def inside(self, x: int, y: int) -> bool:
        return 0 <= x < COLS and y < ROWS

    def free(self, x: int, y: int) -> bool:
        if y < 0:
            return 0 <= x < COLS
        return self.inside(x, y) and self.grid[y][x] is None

    def fits(self, piece: Piece) -> bool:
        return all(self.free(x, y) for x, y in piece.blocks())

    def lock(self, piece: Piece) -> None:
        for x, y in piece.blocks():
            if 0 <= y < ROWS and 0 <= x < COLS:
                self.grid[y][x] = piece.kind

    def full_rows(self) -> list[int]:
        return [y for y in range(ROWS) if all(self.grid[y][x] is not None for x in range(COLS))]

    def clear_rows(self, rows: list[int]) -> None:
        keep = [self.grid[y] for y in range(ROWS) if y not in set(rows)]
        pad = [[None] * COLS for _ in range(len(rows))]
        self.grid = pad + keep

    def occupied_corners(self, piece: Piece) -> int:
        cx, cy = piece.x + 1, piece.y + 1
        count = 0
        for x, y in ((cx - 1, cy - 1), (cx + 1, cy - 1), (cx - 1, cy + 1), (cx + 1, cy + 1)):
            if y < 0:
                continue
            if not self.inside(x, y) or self.grid[y][x] is not None:
                count += 1
        return count


class Scores:
    def __init__(self) -> None:
        self.data = {mode: [] for mode in MODES}
        self.load()

    def load(self) -> None:
        try:
            raw = json.loads(SCORE_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return
        if not isinstance(raw, dict):
            return
        for mode in MODES:
            rows = raw.get(mode, [])
            if isinstance(rows, list):
                self.data[mode] = [row for row in rows if isinstance(row, dict)][:8]

    def save(self) -> None:
        SCORE_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = SCORE_PATH.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.data, indent=2) + "\n", encoding="utf-8")
        tmp.replace(SCORE_PATH)

    def add(self, mode: str, row: dict) -> None:
        bucket = list(self.data.get(mode, []))
        bucket.append(row)
        if mode == "sprint":
            bucket.sort(key=lambda item: (0 if item.get("finished") else 1, item.get("time_ms", 1_000_000_000)))
        else:
            bucket.sort(key=lambda item: -int(item.get("score", 0)))
        self.data[mode] = bucket[:8]
        self.save()

    def best(self, mode: str) -> Optional[dict]:
        rows = self.data.get(mode) or []
        return rows[0] if rows else None


class Game:
    def __init__(self, mode: str) -> None:
        self.mode = mode
        self.board = Board()
        self.bag = Bag()
        self.next = [self.bag.take() for _ in range(3)]
        self.hold: Optional[str] = None
        self.hold_used = False
        self.score = 0
        self.lines = 0
        self.level = 1
        self.combo = -1
        self.b2b = False
        self.alive = True
        self.won = False
        self.saved = False
        self.paused = False
        self.last_rotate = False
        self.lock_resets = 0
        self.lock_until = 0.0
        self.clearing: list[int] = []
        self.clear_until = 0.0
        self.banner = ""
        self.banner_until = 0.0
        self.started = time.monotonic()
        self.elapsed_ms = 0
        self.ended_at: Optional[float] = None
        self.piece = self.spawn()

    def spawn_piece(self, kind: str) -> Optional[Piece]:
        piece = Piece(kind)
        if self.board.fits(piece):
            return piece
        piece.y -= 1
        if self.board.fits(piece):
            return piece
        return None

    def spawn(self) -> Optional[Piece]:
        kind = self.next.pop(0)
        self.next.append(self.bag.take())
        piece = self.spawn_piece(kind)
        self.hold_used = False
        self.last_rotate = False
        self.lock_resets = 0
        self.lock_until = 0.0
        self.gravity_at = time.monotonic() + gravity_ms(self.level) / 1000.0
        if piece is None:
            self.finish(False)
        return piece

    def finish(self, won: bool) -> None:
        if not self.alive:
            return
        self.alive = False
        self.won = won
        self.ended_at = time.monotonic()
        self.elapsed_ms = int((self.ended_at - self.started) * 1000)

    def remaining_ms(self) -> int:
        if self.mode != "ultra":
            return 0
        used = self.clock_ms()
        return max(0, ULTRA_MS - used)

    def clock_ms(self) -> int:
        if self.ended_at is not None:
            return int((self.ended_at - self.started) * 1000)
        if self.paused:
            return self.elapsed_ms
        return int((time.monotonic() - self.started) * 1000)

    def ghost(self) -> Optional[Piece]:
        if self.piece is None:
            return None
        ghost = self.piece.copy()
        while True:
            ghost.y += 1
            if not self.board.fits(ghost):
                ghost.y -= 1
                return ghost

    def try_move(self, dx: int, dy: int) -> bool:
        if self.piece is None or not self.alive or self.paused or self.clearing:
            return False
        nxt = self.piece.copy()
        nxt.x += dx
        nxt.y += dy
        if not self.board.fits(nxt):
            return False
        self.piece = nxt
        self.last_rotate = False
        self.touch_lock(moved=True)
        return True

    def try_rotate(self, delta: int) -> bool:
        if self.piece is None or not self.alive or self.paused or self.clearing:
            return False
        start = self.piece.rot
        dest = (start + delta) % 4
        kicks = [(0, 0)]
        if self.piece.kind == "I":
            kicks = KICKS_I.get((start, dest), kicks)
        elif self.piece.kind != "O":
            kicks = KICKS_JLSTZ.get((start, dest), kicks)
        for kx, ky in kicks:
            nxt = self.piece.copy()
            nxt.rot = dest
            nxt.x += kx
            nxt.y += ky
            if self.board.fits(nxt):
                self.piece = nxt
                self.last_rotate = True
                self.touch_lock(moved=True)
                return True
        return False

    def hard_drop(self) -> None:
        if self.piece is None or not self.alive or self.paused or self.clearing:
            return
        dist = 0
        while self.try_move(0, 1):
            dist += 1
        self.score += dist * 2
        self.lock_piece()

    def soft_drop(self) -> None:
        if self.try_move(0, 1):
            self.score += 1

    def swap_hold(self) -> None:
        if self.piece is None or self.hold_used or not self.alive or self.paused or self.clearing:
            return
        current = self.piece.kind
        if self.hold is None:
            self.hold = current
            self.piece = self.spawn()
        else:
            held = self.hold
            self.hold = current
            self.piece = self.spawn_piece(held)
            if self.piece is None:
                self.finish(False)
                return
            self.last_rotate = False
            self.lock_resets = 0
            self.lock_until = 0.0
            self.gravity_at = time.monotonic() + gravity_ms(self.level) / 1000.0
        self.hold_used = True

    def grounded(self) -> bool:
        if self.piece is None:
            return False
        test = self.piece.copy()
        test.y += 1
        return not self.board.fits(test)

    def touch_lock(self, moved: bool) -> None:
        if not self.grounded():
            self.lock_until = 0.0
            return
        if moved and self.lock_resets < MAX_LOCK_RESETS:
            self.lock_resets += 1
            self.lock_until = time.monotonic() + LOCK_MS / 1000.0
        elif self.lock_until == 0.0:
            self.lock_until = time.monotonic() + LOCK_MS / 1000.0

    def lock_piece(self) -> None:
        if self.piece is None:
            return
        tspin = self.piece.kind == "T" and self.last_rotate and self.board.occupied_corners(self.piece) >= 3
        self.board.lock(self.piece)
        rows = self.board.full_rows()
        if rows:
            self.clearing = rows
            self.clear_until = time.monotonic() + FLASH_MS / 1000.0
            self.pending_tspin = tspin
            self.piece = None
            return
        self.apply_clear(0, tspin)
        self.piece = self.spawn()

    def apply_clear(self, count: int, tspin: bool) -> None:
        difficult = count == 4 or (tspin and count > 0)
        awarded = 0
        label = ""
        if tspin:
            awarded = TSPIN_POINTS.get(count, 400) * self.level
            label = {0: "T-SPIN", 1: "T-SPIN SINGLE", 2: "T-SPIN DOUBLE", 3: "T-SPIN TRIPLE"}.get(count, "T-SPIN")
        elif count:
            awarded = LINE_POINTS[count] * self.level
            label = {1: "SINGLE", 2: "DOUBLE", 3: "TRIPLE", 4: "TETRIS"}[count]
        if count:
            if self.combo >= 0:
                awarded += 50 * self.combo * self.level
            self.combo += 1
            if self.combo >= 1:
                label = f"{label}  x{self.combo + 1}" if label else f"COMBO x{self.combo + 1}"
        else:
            self.combo = -1
        if difficult and self.b2b and awarded:
            awarded = int(awarded * 1.5)
            label = f"B2B {label}" if label else label
        if count:
            self.b2b = difficult
            self.lines += count
            self.level = 1 + self.lines // 10
        if awarded:
            self.score += awarded
        if label:
            self.banner = label
            self.banner_until = time.monotonic() + 1.1
        if self.mode == "sprint" and self.lines >= SPRINT_LINES:
            self.finish(True)
        self.pending_tspin = False

    def tick(self, now: float) -> None:
        if not self.alive or self.paused:
            return
        if self.mode == "ultra" and self.remaining_ms() <= 0:
            self.finish(True)
            return
        if self.clearing:
            if now >= self.clear_until:
                count = len(self.clearing)
                self.board.clear_rows(self.clearing)
                self.clearing = []
                self.apply_clear(count, getattr(self, "pending_tspin", False))
                if self.alive:
                    self.piece = self.spawn()
            return
        if self.piece is None:
            return
        if self.grounded():
            if self.lock_until == 0.0:
                self.touch_lock(moved=False)
            elif now >= self.lock_until:
                self.lock_piece()
            return
        if now >= self.gravity_at:
            self.try_move(0, 1)
            self.gravity_at = now + gravity_ms(self.level) / 1000.0

    def toggle_pause(self) -> None:
        if not self.alive:
            return
        if self.paused:
            paused_for = time.monotonic() - self.pause_started
            self.started += paused_for
            self.gravity_at += paused_for
            if self.lock_until:
                self.lock_until += paused_for
            if self.clear_until:
                self.clear_until += paused_for
            self.paused = False
        else:
            self.elapsed_ms = self.clock_ms()
            self.pause_started = time.monotonic()
            self.paused = True

    pending_tspin = False
    pause_started = 0.0


def ansi_fg(rgb: tuple[int, int, int]) -> str:
    return f"\x1b[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def ansi_bg(rgb: tuple[int, int, int]) -> str:
    return f"\x1b[48;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def paint(text: str, fg: tuple[int, int, int], bg: Optional[tuple[int, int, int]] = None) -> str:
    out = ansi_fg(fg)
    if bg is not None:
        out += ansi_bg(bg)
    return out + text


RESET = "\x1b[0m"


def fmt_score(n: int) -> str:
    return f"{n:,}".replace(",", " ")


def fmt_time(ms: int) -> str:
    ms = max(0, ms)
    minutes, rem = divmod(ms // 1000, 60)
    seconds = rem
    hundredths = (ms % 1000) // 10
    return f"{minutes}:{seconds:02d}.{hundredths:02d}"


def term_size() -> tuple[int, int]:
    try:
        size = os.get_terminal_size()
        return size.columns, size.lines
    except OSError:
        return 80, 24


class Screen:
    def __init__(self, theme: Theme) -> None:
        self.theme = theme
        self.cols, self.rows = term_size()

    def refresh_size(self) -> None:
        self.cols, self.rows = term_size()

    def cell(self, color: tuple[int, int, int], ghost: bool = False) -> str:
        if ghost:
            body = mix(color, self.theme.well, 0.38)
            return paint("░░", body, self.theme.well)
        return paint("  ", self.theme.fg, color)

    def blank_well(self, x: int, y: int) -> str:
        shade = self.theme.well_alt if (x + y) % 2 else self.theme.well
        return paint("  ", self.theme.fg, shade)

    def fill_line(self, width: int, bg: tuple[int, int, int]) -> str:
        return paint(" " * width, self.theme.fg, bg) + RESET


